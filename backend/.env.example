# Anthropic Claude API（AI 分析用）。沒填會自動進入 demo（規則式）模式
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# FinMind 台股資料 API token（可留空，留空為匿名模式，每小時限制較低）
FINMIND_TOKEN=

# JWT 簽章金鑰（正式環境請改成隨機長字串）
SECRET_KEY=dev-secret-change-me

# CORS 允許的前端網址
FRONTEND_ORIGIN=http://localhost:5173

# 管理員 email（逗號分隔）。這些帳號自動具管理權限（名單匯入/外撥/通話內容設定）
ADMIN_EMAILS=

# ---- Twilio 語音電話（inbound AI 客服）----
# Twilio Console 首頁可取得 Account SID / Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# 你的 Twilio 電話號碼（E.164 格式，例：+15551234567）
TWILIO_PHONE_NUMBER=
# 後端對外網址，給 Twilio webhook 回呼用（例：https://your-api.onrender.com）
# 本機用 ngrok 測試時填 ngrok 給的 https 網址
PUBLIC_BASE_URL=
# 正式環境設 true（驗證 webhook 來源）；本機測試可暫設 false
TWILIO_VALIDATE_SIGNATURE=true
